# ---------- Core ----------
NODE_ENV=development
PORT=5001
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/Edubits
JWT_SECRET=replace_with_output_of__openssl_rand_base64_32

# ---------- URLs ----------
# Where the React app runs (used for CORS and OAuth redirects)
FRONTEND_URL=http://localhost:5173
# Public URL of THIS backend, no trailing slash
BACKEND_URL=http://localhost:5001
# Optional override for the OAuth callback origin. In production it defaults
# to FRONTEND_URL; in development it defaults to BACKEND_URL.
# OAUTH_CALLBACK_BASE_URL=https://your-frontend-domain.com
# ---------- Cloudinary ----------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---------- OAuth ----------
# Callback URLs to register with each provider. Use OAUTH_CALLBACK_BASE_URL
# when configured; otherwise use BACKEND_URL.
#   {OAUTH_CALLBACK_BASE_URL}/api/auth/google/callback
#   {OAUTH_CALLBACK_BASE_URL}/api/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: used only when seed:quiz should create the initial admin account.
# Use a unique address and a random password of at least 16 characters.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

