# ---------- Core ----------
NODE_ENV=development
PORT=5001
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/Edubits
JWT_SECRET=replace_with_output_of__openssl_rand_base64_32

# ---------- URLs ----------
# Where the React app runs (used for CORS and OAuth redirects)
FRONTEND_URL=http://localhost:5173
# Public URL of THIS backend, no trailing slash (used for OAuth callbacks)
BACKEND_URL=http://localhost:5001
# Optional extra allowed origins, comma-separated
CORS_ORIGINS=

# ---------- Cloudinary ----------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---------- OAuth ----------
# Callback URLs to register with each provider:
#   {BACKEND_URL}/api/auth/google/callback
#   {BACKEND_URL}/api/auth/github/callback
#   {BACKEND_URL}/api/auth/microsoft/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

